# Copy this file to .env and fill in the values below.

# The site's real, currently-live URL - used for sitemap.xml, robots.txt,
# llms.txt, canonical/OG metadata, and social share links. Set this to
# whatever domain actually serves the site (custom domain if connected,
# otherwise the Vercel deployment URL) so shared links and search-engine
# metadata point to the right place.
NEXT_PUBLIC_SITE_URL="https://www.medsolrealestate.com"

# Postgres connection strings from your Supabase project.
# Settings -> Database -> Connection string.
# URL-encode any special characters in the password (@ ! ( ) etc.).
#
# DATABASE_URL: the app's runtime connection. Use the TRANSACTION pooler
# (port 6543) with pgbouncer=true&connection_limit=5 - this is required on
# serverless (Vercel): each request can spawn its own Postgres connection,
# and without this the small Supabase connection pool gets exhausted under
# completely normal concurrent traffic (we hit this repeatedly in dev with
# just a handful of concurrent scripts against the session pooler).
# Keep connection_limit modest rather than 1: `next build`'s static
# generation runs many pages in parallel against this same URL, and a
# limit of 1 causes those to time out and silently fall back to stale data.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# DIRECT_URL: used only for `prisma migrate` - the session pooler (port 5432),
# not the direct db.<ref>.supabase.co host (that one is IPv6-only and
# unreachable from IPv4-only networks/CI).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Secret used to sign NextAuth session tokens. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Supabase Storage (for Blog media uploads). Settings -> API in the Supabase
# dashboard. SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key (not
# anon/public) - server-only, never expose it to the client.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Resend (transactional email - used for admin password reset emails).
# Get an API key from resend.com -> API Keys.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend's dashboard
# (Domains -> Add Domain, then add the DNS records it gives you).
# The Resend sandbox sender below works with zero setup but is for testing
# only - swap to a verified-domain address before relying on this in prod.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Comma-separated list of addresses to notify when a new lead comes in
# (public form submission or manually added in /admin). Leave unset to
# disable notifications - a new lead is still saved either way, this only
# controls whether anyone gets emailed about it.
LEAD_NOTIFICATION_EMAILS=""

# Sentry (error monitoring). Create a project at sentry.io (platform: Next.js)
# and copy its DSN from Settings -> Projects -> <project> -> Client Keys (DSN).
# Same DSN value in both - one is read client-side, one server/edge-side.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Only needed to upload source maps for readable stack traces (omit these
# three and the build still works, just with minified stack traces in
# Sentry). Auth token: My Settings -> API -> Personal Tokens -> Create New
# Personal Token, with "Release" permission set to Admin and "Project" set
# to Read. Org/project slugs: visible in your Sentry project's URL,
# https://<org-slug>.sentry.io/projects/<project-slug>/
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Google Analytics 4 Data API (powers the "Website Traffic" section on
# /admin/analytics). Setup:
#   1. In Google Cloud Console, enable the "Google Analytics Data API".
#   2. Create a Service Account (IAM & Admin -> Service Accounts), then
#      create a JSON key for it - GOOGLE_ANALYTICS_CLIENT_EMAIL and
#      GOOGLE_ANALYTICS_PRIVATE_KEY below come from that JSON file's
#      "client_email" and "private_key" fields.
#   3. In GA4 (Admin -> Property Access Management), add that service
#      account's email as a Viewer on the property.
#   4. GA4_PROPERTY_ID is the numeric ID under Admin -> Property Settings -
#      NOT the "G-XXXX" measurement ID used in the site's tracking script.
# Leave any of these unset and the traffic section just shows a
# not-connected message instead of breaking the rest of the page.
GA4_PROPERTY_ID=""
GOOGLE_ANALYTICS_CLIENT_EMAIL=""
# The private key's newlines must be escaped as literal \n when stored as a
# single-line env var - most platforms (Vercel included) handle this
# automatically when you paste the multi-line key into their UI.
GOOGLE_ANALYTICS_PRIVATE_KEY=""

# Upstash Redis (rate limiting for login/lead-form/password-reset - shared
# across all serverless instances, unlike an in-memory counter). Create a
# free Redis database at https://console.upstash.com, then copy the REST
# URL and token from its dashboard. Leave unset and the app falls back to
# an in-memory limiter - fine for local dev, NOT safe for production on
# Vercel (each instance/cold-start gets its own counter).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
